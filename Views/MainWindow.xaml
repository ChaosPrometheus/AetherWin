<Window x:Class="WindowManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="AetherWin"
        Height="620" Width="960"
        MinHeight="500" MinWidth="800"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Основной контент -->
        <Grid Grid.Row="0" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: список окон -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="Открытые окна" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Обновить" Style="{StaticResource ModernButton}"
                                Command="{Binding RefreshWindowsCommand}"
                                HorizontalAlignment="Right" Padding="10,4"/>
                    </DockPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Windows}"
                             SelectedItem="{Binding SelectedWindow}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayTitle}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" FontSize="13"/>
                                        <TextBlock Text="{Binding ProcessName}" FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="📌" FontSize="12" Margin="0,0,4,0"
                                                   Visibility="{Binding IsAlwaysOnTop, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="Always on Top"/>
                                        <TextBlock Text="⬜" FontSize="12"
                                                   Visibility="{Binding IsMaximized, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="Развёрнуто"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Правая панель: действия -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Действия" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="Выбранное окно" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                        <Button Content="Активировать" Style="{StaticResource ModernButton}"
                                Command="{Binding ActivateWindowCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>

                        <Button Content="📌 Always on Top" Style="{StaticResource ModernButton}"
                                Command="{Binding ToggleAlwaysOnTopCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>

                        <Button Content="Развернуть" Style="{StaticResource ModernButton}"
                                Command="{Binding MaximizeWindowCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>

                        <Button Content="Восстановить" Style="{StaticResource ModernButton}"
                                Command="{Binding RestoreWindowCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>

                        <Button Content="Свернуть" Style="{StaticResource ModernButton}"
                                Command="{Binding MinimizeWindowCommand}" Margin="0,0,0,16" HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Прозрачность" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Opacity, StringFormat={}{0}%}" DockPanel.Dock="Right"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
                            <Slider Minimum="20" Maximum="100" Value="{Binding Opacity}"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Foreground="{StaticResource PrimaryBrush}"/>
                        </DockPanel>

                        <Button Content="Применить прозрачность" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyOpacityCommand}" Margin="0,0,0,20" HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Раскладки" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                        <TextBox Text="{Binding NewLayoutName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#1A1A1A" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" Padding="8,6" Margin="0,0,0,6"/>

                        <Button Content="💾 Сохранить текущую" Style="{StaticResource ModernButton}"
                                Command="{Binding SaveLayoutCommand}" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

                        <ListBox ItemsSource="{Binding Layouts}"
                                 SelectedItem="{Binding SelectedLayout}"
                                 Background="Transparent" BorderThickness="0"
                                 MaxHeight="140" Margin="0,0,0,8">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Content="Применить раскладку" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyLayoutCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>

                        <Button Content="Удалить раскладку" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteLayoutCommand}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Статусбар -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="16,10">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Ctrl+Shift+T — TopMost | Ctrl+Shift+↑↓ — Прозрачность | Ctrl+Shift+W — Показать"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Трей-иконка (без IconSource, чтобы не было ошибки) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="AetherWin"
                        MenuActivation="RightClick"
                        DoubleClickCommand="{Binding ActivateWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Показать" Click="ShowWindow_Click"/>
                    <MenuItem Header="Обновить окна" Command="{Binding RefreshWindowsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>